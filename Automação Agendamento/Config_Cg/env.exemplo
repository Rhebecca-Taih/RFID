# CONFIGURAÇÕES -- Agendamento (Agendamento_auto) -- EXEMPLO
# Copie este arquivo, renomeie para ".env" (dentro da mesma pasta Config_Cg)
# e preencha com os seus caminhos reais.
# Pasta onde os arquivos de origem ficam (pode ter vários ao mesmo tempo)
ORIGEM_PASTA=G:\SuaPasta\PastaDeOrigem

# Padrão de busca (pega qualquer arquivo que comece assim)
ORIGEM_PADRAO=NOME_DO_ARQUIVO*.xlsm

# Nome fixo salvo no destino (nunca a variação do nome original)
NOME_DESTINO=NOME_DO_ARQUIVO.xlsm

# Pasta de destino para onde o arquivo mais recente é copiado
DESTINO_PASTA=G:\SuaPasta\Destino

# Minutos para aguardar após detectar um arquivo novo/mais recente
MINUTOS_ESPERA=2

# Segundos entre cada verificação da pasta de origem
INTERVALO_CHECK=10

# Tentativas de cópia antes de registrar falha definitiva
MAX_TENTATIVAS=3

# Crédito -- aparece no cabeçalho da janela
NOME_CRIADOR=SeuNome
LINK_GITHUB_CRIADOR=https://github.com/SeuUsuario
