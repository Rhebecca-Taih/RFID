# DADOS SENSÍVEIS -- EXEMPLO
# IMPORTANTE: nunca compartilhar o arquivo ".env" de verdade! Ele guarda
# as senhas dos robôs.
#
# COMO USAR:
# 1. Copie este arquivo, renomeie para ".env"
# 2. Mantenha na mesma pasta (Config_Cg\, compartilhada pelos robôs)
# 3. Preencha com os dados reais

# 🔴 ROBÔ APROVADOR
# Pasta de rede com Chrome/Driver (copiada para o PC na 1ª execução)
CAMINHO_REDE_BIN=G:\SuaPasta\Aprovador_Bot

# Credenciais do portal de pedidos
PORTAL_USER=seu.usuario@empresa.com
PORTAL_SENHA=suasenha

# URL de login do portal e nome do Site a selecionar depois do login
PORTAL_URL_LOGIN=https://portal.exemplo.com/auth/login
PORTAL_SITE=NomeDoSite

# 🟡 ROBÔ PREPARADOR
# Planilha de mapeamento de fornecedores (abre quando detecta um
# fornecedor não mapeado)
CAMINHO_FORNECEDORES=G:\SuaPasta\fornecedores.xlsx

# Setores disponíveis na tela (separados por vírgula, sem espaço)
SETORES_PREPARADOR=SETOR1,SETOR2

# 🟢 ROBÔ IMPRESSÃO
# Credenciais/URL/Site vêm da seção do Aprovador acima (login compartilhado)

# Cópia de rede da BASE GERAL (lida como referência, nunca aberta direto)
CAMINHO_REDE_BASE_GERAL=G:\SuaPasta\Base Geral\BASE GERAL.xlsx

# Link público (sem login) da planilha "Colmeia de Artigos" no OneDrive
LINK_COLMEIA_ARTIGOS=https://onedrive.exemplo.com/link-publico-da-planilha

# Opcional -- modelos de etiqueta e impressoras disponíveis na tela
# (separados por vírgula, sem espaço; já têm um padrão se não definir)
# MODELOS_ETIQUETA_IMPRESSAO=72x17 Eletro,46x8 Beleza,64x7 Beleza,44x19,44x19 Beleza
# IMPRESSORAS_DISPONIVEIS=SATO 1,SATO 2,SATO 3,SATO PLUS METAL
