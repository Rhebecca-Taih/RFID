# CONFIGURAÇÕES -- Robô Sincronizador (BASE_GERAL_auto) -- EXEMPLO
# Copie este arquivo, renomeie para ".env" (na mesma pasta do robô) e
# preencha com os seus dados reais.
# Login usado para acessar o SharePoint/Google Sheets de origem
LOGIN_EMAIL=seu@email.com
LOGIN_SENHA=suasenha

# Caminho de rede da BASE GERAL (arquivo final, atualizado pelo robô)
CAMINHO_REDE=\\servidor\pasta\BASE_GERAL.xlsx

# Links dos arquivos de origem (SharePoint / Google Sheets)
LINK_EMISSAO=https://exemplo.sharepoint.com/seu-link-aqui
LINK_ETIQUETAS=https://docs.google.com/spreadsheets/d/seu-id/export?format=xlsx

# Nomes esperados dos arquivos baixados (ajuste aqui se mudar de ano/nome)
NOME_ARQ_EMISSAO=CONTROLE EMISSÃO 2026*
NOME_ARQ_ETIQUETAS=Solicitação de Etiquetas*

# Aba/categoria do parceiro logístico especial (aba própria na BASE GERAL,
# além de AGENDADOS e FORA DE AGENDA)
CATEGORIA_PARCEIRO=NOME_DO_PARCEIRO

# Pasta de rede com Chrome/Driver (copiada automaticamente para o PC na
# primeira execução, se ainda não existir localmente)
CAMINHO_REDE_BIN=G:\SuaPasta\Bin
