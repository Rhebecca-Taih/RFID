# CONFIGURAÇÕES -- Robô Controle KPI OneDrive -- EXEMPLO
# Copie este arquivo, renomeie para ".env" (dentro da mesma pasta Config_Cg)
# e preencha com os seus caminhos reais.
# Nome da pasta raiz do OneDrive dentro do perfil do usuário (como aparece
# em C:\Users\<usuário>\<PASTA_ONEDRIVE_BASE>\...). O nome do usuário em si
# NUNCA vai aqui -- é resolvido automaticamente em tempo real (USERNAME do Windows).
PASTA_ONEDRIVE_BASE=Nome da Empresa

# Segundos entre cada verificação da origem (a cópia só acontece se mudou)
INTERVALO_CHECK_SEGUNDOS=3600

# Segundos de espera após detectar mudança, antes de copiar
SEGUNDOS_ESPERA=20

# Tentativas de cópia antes de registrar falha definitiva
MAX_TENTATIVAS=3

# ------------------------------------------------------------------------------
# TAREFAS -- cada tarefa é um trio TAREFA_N_* (N = 1, 2, 3...). O robô
# carrega quantas tarefas existirem, sem precisar mexer no código para
# adicionar uma nova -- basta acrescentar mais um trio abaixo.
# ------------------------------------------------------------------------------

# Tarefa 1
TAREFA_1_ORIGEM=G:\SuaPasta\PastaDeOrigem\ARQUIVO.xlsx
TAREFA_1_DESTINO_SUBPASTA=Pasta - Nome da Biblioteca
TAREFA_1_NOME=ARQUIVO.xlsx
# Link do SharePoint (opcional) -- mostrado na tela se a pasta de destino
# ainda não existir nesse PC (OneDrive nunca sincronizou essa biblioteca)
TAREFA_1_LINK_SHAREPOINT=https://empresa.sharepoint.com/sites/SuaBiblioteca

# Tarefa 2 (exemplo -- repita o padrão acima para cada tarefa adicional)
# TAREFA_2_ORIGEM=G:\SuaPasta\OutraPastaDeOrigem\OUTRO_ARQUIVO.xlsx
# TAREFA_2_DESTINO_SUBPASTA=Pasta - Outra Biblioteca
# TAREFA_2_NOME=OUTRO_ARQUIVO.xlsx
# TAREFA_2_LINK_SHAREPOINT=https://empresa.sharepoint.com/sites/OutraBiblioteca

# Crédito -- aparece no cabeçalho da janela
NOME_CRIADOR=SeuNome
LINK_GITHUB_CRIADOR=https://github.com/SeuUsuario
